# ==============================================================================
# BountyFi environment template. Copy to .env and fill in. Never commit .env.
# ==============================================================================

# --- Server ---------------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Browser origins allowed to call the API directly. Not needed when nginx proxies /api on the same origin.
# Production: leave empty, or https://bountyfi.xyz if the site calls the API from another origin.
CORS_ORIGIN=http://localhost:5173
# Local development: postgresql://postgres:<password>@localhost:5432/fixbounty
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# --- Arc chain ------------------------------------------------------------------
ARC_RPC_URL=https://rpc.testnet.arc.io
VITE_ARC_RPC_URL=https://rpc.testnet.arc.io
VITE_ARC_CHAIN_ID=5042002
VITE_ARC_EXPLORER_URL=https://explorer.testnet.arc.io
USDC_ADDRESS=0x3600000000000000000000000000000000000000

# BountyBoard v2 address and the block it was deployed in (the indexer starts there).
# If INDEXER_START_BLOCK is empty the server searches for the deployment block itself.
BOUNTY_BOARD_ADDRESS=
INDEXER_START_BLOCK=

# Wallet that receives every platform fee. Baked into the contract at deployment.
TREASURY_ADDRESS=

# --- Wallet connection -------------------------------------------------------------
# From https://cloud.reown.com. Leave empty to offer browser wallets only.
VITE_WALLETCONNECT_PROJECT_ID=

# --- Browser to API ------------------------------------------------------------------
VITE_API_URL=/api

# --- Google sign-in (Firebase) ------------------------------------------------------
# Firebase console: Authentication > Sign-in method > Google, and add your domain under Settings > Authorized domains.
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Admin access -----------------------------------------------------------------------
# Comma separated Google e-mails that can open /admin. Matched against the verified e-mail on the ID token.
ADMIN_EMAILS=

# --- Buy USDC with a card (optional) ---------------------------------------------------
# Circle Onramp. SERVER-SIDE SECRET: set it only in the backend environment (for example Coolify), never as a VITE_ variable.
# Use the key exactly as Circle issued it: TEST_API_KEY:<id>:<secret> on the testnet, LIVE_API_KEY:<id>:<secret> on mainnet.
# Leave blank to hide the "Buy USDC" button. ONRAMP_CHAIN is the chain Circle delivers to (default arc).
# docker-compose.coolify.yml must pass these two names to the API container (see docs/DEPLOYMENT.md).
ONRAMP_API_KEY=
ONRAMP_CHAIN=arc

# --- Social profiles shown in the footer (optional, public https addresses) ------------------
# Each defaults to https://bountyfi.xyz. Set an address to link a real account, public values only.
# Bridge and Swap on the Wallet page need no key: they run in the browser with the user's own wallet.
VITE_SOCIAL_X=
VITE_SOCIAL_LINKEDIN=
VITE_SOCIAL_TELEGRAM=
VITE_SOCIAL_DISCORD=
